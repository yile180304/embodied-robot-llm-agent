# OpenAI-compatible Qwen/DeepSeek provider. Copy to .env locally; never commit keys.
EMBODIED_AGENT_API_KEY=
EMBODIED_AGENT_MODEL=
EMBODIED_AGENT_BASE_URL=
EMBODIED_AGENT_TEMPERATURE=0
EMBODIED_AGENT_TIMEOUT_S=30

# MQTT host and port are explicit CLI flags. Keil tool paths are optional shell
# environment variables (KEIL_UV4 and ARMCLANG), not dotenv configuration.
